<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClaudeTerm" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- WebView 选区：高亮带主力走 CSS ::selection(随主题=气泡色)，这里是兜底暖调；手柄/光标用低饱和暖灰 -->
        <item name="android:textColorHighlight">@color/sel_highlight</item>
        <item name="colorAccent">@color/sel_handle</item>
        <item name="android:colorControlActivated">@color/sel_handle</item>
    </style>
</resources>
